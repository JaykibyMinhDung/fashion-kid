# Giá trị local-development công khai; không dùng các giá trị này ở production.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://kids_fashion:kids_fashion_dev@localhost:54329/kids_fashion?schema=public
DEMO_PASSWORD=ChangeMe123!
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=kids-fashion-api
JWT_AUDIENCE=kids-fashion-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=24
REMEMBER_REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_REFRESH_INACTIVITY_DAYS=7
MAX_CART_ITEM_QTY=99
COOKIE_SECURE=false
SHIPPING_FALLBACK_FEE=30000
SHIPPING_QUOTE_TTL_SECONDS=300
# VNPay sandbox (chỉ bật khi đã có credential hợp lệ)
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/payment-return
# VNPay IPN phải trỏ tới API public; localhost chỉ dùng cho mock/manual test.
VNPAY_IPN_URL=http://localhost:8080/api/v1/webhooks/payments/vnpay/ipn
VNPAY_TEST_MODE=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
